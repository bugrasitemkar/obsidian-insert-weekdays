{
  "name": "obsidian-insert-week",
  "version": "1.0.2",
  "description": "Insert a dated week template (Monday-Sunday headings with checkboxes) using a command and a configurable modal.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "week",
    "weekly"
  ],
  "author": "Bugra Sitemkar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bugrasitemkar/obsidian-insert-weekdays.git"
  },
  "homepage": "https://github.com/bugrasitemkar/obsidian-insert-weekdays#readme",
  "bugs": {
    "url": "https://github.com/bugrasitemkar/obsidian-insert-weekdays/issues"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.11",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.6.0"
  }
}
